<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Hand-drawn line icons in an SF-Symbols-style visual language: 24x24 grid,
    ~1.6px stroke weight, rounded line caps/joins, minimal geometric forms.

    These are NOT Apple's SF Symbols — Apple's SF Symbols font/glyphs are
    licensed only for use in software built for Apple platforms, so the actual
    glyph files can't be embedded in a cross-platform Avalonia app. These are
    original vector paths drawn to read the same way: thin, consistent,
    geometric — so use them via IconPath below rather than reaching for an
    emoji/Unicode character next time an icon is needed.
  -->

  <StreamGeometry x:Key="IconSidebar">M4 5.5 L4 18.5 M9 4 L20 4 Q21 4 21 5 L21 19 Q21 20 20 20 L9 20 Z</StreamGeometry>
  <StreamGeometry x:Key="IconPlus">M12 5 L12 19 M5 12 L19 12</StreamGeometry>
  <!-- Circles below are built from four 90° arcs rather than two 180° ones —
       an exact half-circle arc is a degenerate case in the SVG arc spec (the
       flag combination is ambiguous at precisely 180°), which different
       renderers resolve differently and can come out distorted. Quarter arcs
       have no such ambiguity. -->
  <StreamGeometry x:Key="IconSearch">M18 11 A7 7 0 0 1 11 18 A7 7 0 0 1 4 11 A7 7 0 0 1 11 4 A7 7 0 0 1 18 11 Z M16 16 L21 21</StreamGeometry>
  <!-- Simple, legible "sort/group by" glyph (three descending bars) rather than a
       tiny gamepad silhouette, which read as a garbled blob at 13px. -->
  <StreamGeometry x:Key="IconGroupBy">M4 6 L20 6 M7 12 L17 12 M10 18 L14 18</StreamGeometry>
  <StreamGeometry x:Key="IconFilter">M3.5 5 L20.5 5 L14 12.5 L14 18.5 L10 20.5 L10 12.5 Z</StreamGeometry>
  <StreamGeometry x:Key="IconChevronDown">M6 9 L12 15 L18 9</StreamGeometry>
  <StreamGeometry x:Key="IconPencil">M6 18 L6 14.5 L15.5 5 Q16.3 4.2 17.1 5 L19 6.9 Q19.8 7.7 19 8.5 L9.5 18 Z M14 6.5 L17.5 10</StreamGeometry>
  <StreamGeometry x:Key="IconXmark">M6 6 L18 18 M18 6 L6 18</StreamGeometry>
  <StreamGeometry x:Key="IconSparkles">M8 4 L9.2 7.3 L12.5 8.5 L9.2 9.7 L8 13 L6.8 9.7 L3.5 8.5 L6.8 7.3 Z M17 12 L17.9 14.4 L20.3 15.3 L17.9 16.2 L17 18.6 L16.1 16.2 L13.7 15.3 L16.1 14.4 Z</StreamGeometry>
  <StreamGeometry x:Key="IconPlayFilled">M6.5 4.8 L18.5 12 L6.5 19.2 Z</StreamGeometry>
  <StreamGeometry x:Key="IconStarFilled">M12 3.5 L14.6 9 L20.5 9.7 L16.1 13.7 L17.3 19.6 L12 16.6 L6.7 19.6 L7.9 13.7 L3.5 9.7 L9.4 9 Z</StreamGeometry>
  <StreamGeometry x:Key="IconGear">M12 2.5 L13 5.2 Q14.6 5.6 15.9 6.5 L18.5 5.5 L20 8.1 L18 10 Q18.2 10.9 18.2 12 Q18.2 13.1 18 14 L20 15.9 L18.5 18.5 L15.9 17.5 Q14.6 18.4 13 18.8 L12 21.5 L10 21.5 L9 18.8 Q7.4 18.4 6.1 17.5 L3.5 18.5 L2 15.9 L4 14 Q3.8 13.1 3.8 12 Q3.8 10.9 4 10 L2 8.1 L3.5 5.5 L6.1 6.5 Q7.4 5.6 9 5.2 Z M15.3 12 A3.3 3.3 0 0 1 12 15.3 A3.3 3.3 0 0 1 8.7 12 A3.3 3.3 0 0 1 12 8.7 A3.3 3.3 0 0 1 15.3 12 Z</StreamGeometry>
  <StreamGeometry x:Key="IconPerson">M16 7.5 A4 4 0 0 1 12 11.5 A4 4 0 0 1 8 7.5 A4 4 0 0 1 12 3.5 A4 4 0 0 1 16 7.5 Z M4.5 20.5 Q5.5 13.5 12 13.5 Q18.5 13.5 19.5 20.5</StreamGeometry>
  <StreamGeometry x:Key="IconFolder">M3.5 7 Q3.5 5.5 5 5.5 L9.5 5.5 L11.2 7.5 L19 7.5 Q20.5 7.5 20.5 9 L20.5 17 Q20.5 18.5 19 18.5 L5 18.5 Q3.5 18.5 3.5 17 Z</StreamGeometry>

</ResourceDictionary>
